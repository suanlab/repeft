{
    "name": "gpt2_lora_wikitext_sweep",
    "description": "Real LoRA fine-tuning sweep: GPT-2 on WikiText-2 with varying lr, rank, alpha, and epochs",
    "base_command": "python3 real_lora_train.py --model gpt2 --dataset wikitext --dataset-config wikitext-2-raw-v1 --output-dir . --lr {lr} --lora-r {rank} --lora-alpha {alpha} --num-epochs {epochs} --batch-size 4 --seq-length 128 --max-samples 2000 --max-eval-samples 500 --seed 42",
    "parameters": {
        "lr":     [0.00005, 0.0002, 0.001],
        "rank":   [4, 8, 16],
        "alpha":  [16, 32, 64],
        "epochs": [1, 2]
    },
    "stage_files": ["/projects/REPEFT/real_lora_train.py"],
    "optimize": "eval_loss",
    "mode": "min",
    "job_timeout": 600,
    "env_dir": "$HOME/mlenv"
}
